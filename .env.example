# Deployed site URL (a trailing slash is fine). Used for the canonical, Open Graph, Twitter and JSON-LD URLs in index.html.
# Optional on Vercel and Netlify, whose production URL is detected automatically; required on other hosts.
# Set it in your host's build environment, or copy this line into .env.production.local (git-ignored).
VITE_SITE_URL=https://your-domain.com
